# LLM provider
NALPLAN_LLM_BASE_URL=https://api.openai.com/v1
NALPLAN_LLM_API_KEY=
NALPLAN_LLM_MODEL=gpt-4o
NALPLAN_EMBEDDING_MODEL=text-embedding-3-large

# Local SECONDO installation
SECONDO_HOME=$HOME/secondo
SECONDO_BIN=$HOME/secondo/bin/SecondoBDB
SECONDO_ALGEBRAS=$HOME/secondo/Algebras
SECONDO_DATABASE_ROOT=$HOME/secondo-databases

# Optional pipeline parameters
NALPLAN_NUM_PATHS=7
NALPLAN_CANDIDATES_PER_PATH=3
NALPLAN_OPERATOR_DEPTH=30
NALPLAN_TEMPERATURE=0.85
NALPLAN_QUERY_TIMEOUT=10
